# API Keys for LLM Providers
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL database connection URL
# Default local user is postgres, password postgres, database web_rag
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_rag

# Qdrant Vector DB Settings
# For local Qdrant, leave these blank or commented
# For Serverless Cloud Qdrant, fill them in:
# QDRANT_URL=https://xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here
